#!/usr/bin/env bash
# ==============================================================================
# config.local.sh.example
#   Copy this to config.local.sh and adjust it for your machine.
#   config.sh sources it last, so anything here overrides the defaults.
#
#     cp config.local.sh.example config.local.sh
#
#   It holds your AdminPassword, so keep it out of version control.
# ==============================================================================

# --- Wine executable (setup.sh can find it, but naming it here is safer) ------
# CrossOver:
# WINE_BIN="/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wine"
# Homebrew wine / Game Porting Toolkit:
# WINE_BIN="$(brew --prefix)/bin/wine64"

# --- RCON (safe shutdown, player list, auto-restart conditions) ---------------
# Must match AdminPassword in PalWorldSettings.ini.
# RCON_PASSWORD="a-strong-password"
# RCON_PORT=25575
# RCON_SHUTDOWN_DELAY=30      # seconds of shutdown warning

# --- Ports and capacity ------------------------------------------------------
# GAME_PORT=8211
# MAX_PLAYERS=32

# --- Paths -------------------------------------------------------------------
# PAL_ROOT="$HOME/PalworldServer"
# BACKUP_DIR="$HOME/palworld_backups"

# --- Backup retention --------------------------------------------------------
# BACKUP_RETENTION_DAYS=14    # delete backups older than this
# BACKUP_RETENTION_MIN=10     # but always keep at least this many
